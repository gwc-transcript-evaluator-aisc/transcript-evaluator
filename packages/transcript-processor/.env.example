# ---------------------------------------------------------------
# Lambda environment variables reference.
# Set these in the Lambda console under Configuration > Environment variables.
# Do NOT use this file directly on Lambda — it is for local reference only.
# ---------------------------------------------------------------

# S3
S3_BUCKET_INPUT=transcript-input-groupten
S3_BUCKET_OUTPUT=transcript-output-groupten
S3_INPUT_PREFIX=transcripts/
S3_OUTPUT_PREFIX=bda-output/

# Bedrock Data Automation
# Leave BDA_PROJECT_ARN blank to let the app create a project automatically on first run.
# Once created, paste the ARN here to skip the creation step on future cold starts.
BDA_PROJECT_ARN=
BDA_PROJECT_NAME=student-transcript-processor
BDA_PROFILE_ARN=arn:aws:bedrock:us-west-2:780604190632:data-automation-profile/us.data-automation-v1

# Aurora PostgreSQL (CDK supplies these values; do not put database passwords in Lambda env)
DB_HOST=
DB_PORT=5432
DB_NAME=transcripts
DB_USER=transcript_processor
DB_SECRET_ARN=

# Note: AWS_REGION is set automatically by Lambda — do not add it manually.
# Note: AWS credentials are not needed — the IAM role handles authentication.
